generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Phase 1 ───────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  role          Role           @default(CUSTOMER)
  phone         String?
  company       String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  refreshTokens RefreshToken[]
  leads         Lead[]
  leadReplies   LeadReply[]        @relation("LeadReplySentBy")
  orders        Order[]
  reviews       Review[]
  statusEvents  OrderStatusEvent[] @relation("StatusChangedBy")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lead {
  id                String          @id @default(cuid())
  name              String
  email             String
  phone             String?
  subject           String?
  message           String?
  company           String?
  website           String?
  monthlyBudget     String?
  purpose           String?
  highValue         Boolean         @default(false)
  privacyAcceptedAt DateTime?
  source            String          @default("contact_form")
  status            LeadStatus      @default(NEW)
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies           LeadReply[]
  scheduledCalls    ScheduledCall[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([email])
  @@index([status])
  @@index([highValue])
  @@index([source])
}

model LeadReply {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  sentById  String?
  sentBy    User?    @relation("LeadReplySentBy", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([leadId])
}

enum CallChannel {
  MEET
  WHATSAPP
  PHONE
}

enum CallStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ScheduledCall {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  durationMin Int         @default(30)
  channel     CallChannel
  meetingUrl  String?
  status      CallStatus  @default(SCHEDULED)
  manageToken String      @unique
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([leadId])
}

model AvailabilityRule {
  id        String @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String @default("Asia/Dhaka")

  @@unique([dayOfWeek])
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
}

model MarketplaceListing {
  id          Int      @id @default(autoincrement())
  domain      String   @unique
  niche       String
  da          Int
  dr          Int
  traffic     Int
  country     String
  maxDofollow Int
  guest       Int
  insert      Int
  tat         String
  owner       String
  trend       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([niche])
  @@index([country])
  @@index([guest])
  @@index([dr])
  @@index([da])
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum CtaRequestStatus {
  NEW
  CONTACTED
  CONVERTED
}

enum CtaAiStatus {
  PENDING
  READY
  FAILED
}

model CtaRequest {
  id             String           @id @default(cuid())
  email          String
  niche          String
  budget         String
  status         CtaRequestStatus @default(NEW)
  aiStatus       CtaAiStatus      @default(PENDING)
  writeTokenHash String?
  summary        String?
  strategy       String?
  tips           Json?
  recommendations Json?
  aiError        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@index([aiStatus])
  @@index([createdAt])
}

// ─── Phase 2 (orders / checkout) ────────────────────────────────────────────

enum OrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPING
  DELIVERING
  COMPLETE
  FAILED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum ServiceType {
  GUEST
  INSERT
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  type             PromoDiscountType
  /// PERCENT: 1–100. FIXED: amount in cents.
  value            Int
  minOrderCents    Int                @default(0)
  maxDiscountCents Int?
  maxUses          Int?
  usedCount        Int                @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean            @default(true)
  orders           Order[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([active])
}

model Order {
  id                    String             @id @default(cuid())
  orderNumber           String             @unique
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                OrderStatus        @default(PENDING)
  paymentStatus         PaymentStatus      @default(UNPAID)
  stripePaymentIntentId String?            @unique
  currency              String             @default("usd")
  subtotalCents         Int
  discountCents         Int                @default(0)
  totalCents            Int
  promoCodeId           String?
  promoCode             PromoCode?         @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeLabel        String?
  manualTotalCents      Int?
  notes                 String?
  billingName           String
  billingEmail          String
  billingPhone          String
  billingCompany        String?
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  country               String
  items                 OrderItem[]
  statusEvents          OrderStatusEvent[]
  review                Review?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  description String
  showOnHome  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([showOnHome])
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId      Int
  domain         String
  niche          String
  serviceType    ServiceType
  unitPriceCents Int
  quantity       Int         @default(1)
  lineTotalCents Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([orderId])
  @@index([listingId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  changedBy   User?        @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
}
